<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "windows-setup": the GitHub artifact
     windows-setup-unsigned of the CI, the two NSIS installers (made from
     the programs already signed). Paste it into the project on SignPath. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="skiff-setup-*-windows-amd64.exe" />
      <include path="skiff-setup-*-windows-arm64.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
